# keep the build context (and image) small + reproducible
.git
.git/**
.github
**/__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
.mypy_cache/
.wrangler/
*.egg-info/
build/
dist/
.venv/
venv/
env/
node_modules/
# runtime/local state must never bake into the image
.bourdon/
agent-library/
*.log
# not needed at runtime (keep the image tiny — the server is core/ + cli/ + participants/)
tray/
tests/
BENCHMARKS/
conformance/
marketing-site*/
web/
spec/
plans/
starter-template/
homebrew/
Formula/
examples/
ARCHIVE/
docs/
*.md
!README.md
